# Single source of truth for external tool locations.
#
# Consumed by all three languages in this repo:
#   Makefile              -> include toolpaths.env
#   scripts/ci_test.sh     -> . "$ROOT/toolpaths.env"
#   scripts/toolpaths.py   -> parsed; used by every Python harness
#
# These paths used to be copy-pasted into the Makefile, ci_test.sh and 15
# separate Python scripts. They drifted, exactly as you would expect: commit
# 63659cd is "fix: correct stale Python path in ci_test.sh". Change a tool
# location here and every entry point follows.
#
# FORMAT: `KEY=value`, no spaces around '=', and no spaces or quotes in the
# value. That is the intersection of what make's `include`, bash's `.` and a
# trivial Python parser all accept from the same file. A path containing spaces
# would need per-language quoting and would break that property — if you ever
# need one, set the matching environment variable instead (it wins over this
# file in the Python and shell consumers).

KICKASS_JAR=C:/debugger/kickasm/KickAss.jar
VICE_X64SC=C:/Users/mit/claude/c64server/vice-sidvariant/GTK3VICE-3.9-win64/bin/x64sc.exe
